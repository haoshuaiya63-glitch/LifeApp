<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mumu.dazi" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>Happy</name>
    <description>MuMu and DaZi</description>
    <author email="example@example.com" href="http://example.com">MuMu</author>

    <content src="index.html" />

    <!-- ========== 网络访问 ========== -->
    <!-- 后端：http://43.167.237.62:8000 / 3600 / 3800 / 7800 -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- ========== WebView 基本设置 ========== -->
    <!-- 页面来源为 http://localhost，避免 https 页面请求 http 接口被"混合内容"拦截 -->
    <preference name="Scheme" value="http" />
    <preference name="Hostname" value="localhost" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xffffffff" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- ========== 关闭启动动画 ========== -->
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreen" value="false" />
    <!-- Android 12+ 系统强制显示启动页，无法彻底移除：
         图标设为透明、背景设为白色，视觉上等于没有 -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/transparent.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
    <preference name="AndroidPostSplashScreenTheme" value="@style/Theme.AppCompat.NoActionBar" />

    <platform name="android">
        <!-- ========== 桌面图标 ========== -->
        <icon src="icon.png" />

        <!-- 允许明文 HTTP（后端不是 https，不加会被系统拦截） -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>

        <!-- ========== 权限声明 ========== -->
        <config-file target="app/src/main/AndroidManifest.xml" parent="/manifest">
            <!-- 网络 -->
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <!-- 评论长按录音 -->
            <uses-permission android:name="android.permission.RECORD_AUDIO" />
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
            <!-- 发帖/评论定位 -->
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <!-- 随机抽取时震动 -->
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>
    </platform>
</widget>
